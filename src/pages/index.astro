---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Ambil Nomor Antrean">
  <main class="max-w-md mx-auto min-h-screen flex flex-col justify-between p-6">
    <header class="text-center pt-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold mb-3">
        <span id="status-dot" class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span id="operational-badge">Memuat Status...</span>
      </div>
      <h1 id="booth-name" class="text-2xl font-extrabold text-slate-900">SnapStudio Photobooth</h1>
      <p class="text-sm text-slate-500 mt-1">Ambil nomor antrean digital secara mandiri tanpa perlu login</p>
    </header>

    <section class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 my-6">
      <div class="grid grid-cols-2 gap-3 mb-6">
        <div class="bg-slate-50 p-3.5 rounded-xl text-center border border-slate-100">
          <span class="text-xs text-slate-500 block">Sedang Dipanggil</span>
          <strong id="current-called" class="text-2xl font-extrabold text-indigo-600 mt-0.5 block">-</strong>
        </div>
        <div class="bg-slate-50 p-3.5 rounded-xl text-center border border-slate-100">
          <span class="text-xs text-slate-500 block">Estimasi Tunggu</span>
          <strong id="est-wait" class="text-2xl font-extrabold text-slate-800 mt-0.5 block">0 mnt</strong>
        </div>
      </div>

      <form id="register-form" class="space-y-4">
        <div>
          <label for="visitor-name" class="block text-sm font-semibold text-slate-700 mb-1.5">
            Nama Pengunjung <span class="text-rose-500">*</span>
          </label>
          <input
            id="visitor-name"
            name="visitor_name"
            type="text"
            required
            minlength="2"
            maxlength="100"
            placeholder="Contoh: Rina Wijaya"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm"
          />
        </div>

        <div id="error-box" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium"></div>

        <button
          id="submit-btn"
          type="submit"
          class="w-full py-3.5 px-5 rounded-xl bg-indigo-600 hover:bg-indigo-700 disabled:bg-slate-300 text-white font-bold text-sm shadow-sm transition"
        >
          Ambil Nomor Antrean
        </button>
      </form>
    </section>

    <footer class="text-center text-xs text-slate-400 pb-4 flex justify-center gap-4">
      <a href="/display" class="hover:text-indigo-600 underline">Layar Mobile Display</a>
      <span>•</span>
      <a href="/admin" class="hover:text-indigo-600 underline">Dashboard Admin</a>
    </footer>
  </main>

  <script>
    import { supabase, getClientFingerprint } from '../lib/supabase';

    const form = document.getElementById('register-form') as HTMLFormElement;
    const nameInput = document.getElementById('visitor-name') as HTMLInputElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const errorBox = document.getElementById('error-box')!;
    const boothNameEl = document.getElementById('booth-name')!;
    const currentCalledEl = document.getElementById('current-called')!;
    const estWaitEl = document.getElementById('est-wait')!;
    const badgeEl = document.getElementById('operational-badge')!;
    const dotEl = document.getElementById('status-dot')!;

    async function loadPublicInfo() {
      if (!supabase) return;
      const { data, error } = await supabase.rpc('get_public_display');
      if (error || !data) return;

      boothNameEl.textContent = data.photobooth_name || 'Photobooth';
      currentCalledEl.textContent = data.currently_called || '-';
      const hasCalled = data.currently_called ? 1 : 0;
      const waitMins = ((data.waiting_count || 0) + hasCalled) * (data.session_duration || 5);
      estWaitEl.textContent = `~${waitMins} mnt`;

      const isFull = data.total_active >= data.queue_limit;
      if (!data.operational_status) {
        badgeEl.textContent = 'Operasional Ditutup';
        dotEl.className = 'w-2 h-2 rounded-full bg-rose-500';
        submitBtn.disabled = true;
      } else if (isFull) {
        badgeEl.textContent = 'Kuota Antrean Penuh';
        dotEl.className = 'w-2 h-2 rounded-full bg-amber-500';
        submitBtn.disabled = true;
      } else {
        badgeEl.textContent = 'Operasional Dibuka';
        dotEl.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';
        submitBtn.disabled = false;
      }
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      const visitorName = nameInput.value.replace(/[<>]/g, '').trim();
      if (visitorName.length < 2) {
        errorBox.textContent = 'Nama pengunjung minimal 2 karakter.';
        errorBox.classList.remove('hidden');
        return;
      }

      if (!supabase) {
        errorBox.textContent = 'Supabase belum dikonfigurasi pada file .env.';
        errorBox.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Memproses...';

      const { data, error } = await supabase.rpc('take_queue', {
        p_visitor_name: visitorName,
        p_client_fingerprint: getClientFingerprint(),
      });

      if (error || !data) {
        errorBox.textContent = error?.message || 'Gagal mengambil nomor antrean.';
        errorBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Ambil Nomor Antrean';
        return;
      }

      window.location.href = `/ticket?t=${encodeURIComponent(data.tracking_token)}`;
    });

    loadPublicInfo();
    // Subscribe ke tabel public_queue_sync (yang diizinkan RLS untuk anon) + fallback polling 4 detik
    if (supabase) {
      supabase
        .channel('public-registration-sync')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'public_queue_sync' }, loadPublicInfo)
        .on('postgres_changes', { event: '*', schema: 'public', table: 'queue_settings' }, loadPublicInfo)
        .subscribe();
      setInterval(loadPublicInfo, 4000);
    }
  </script>
</Layout>
