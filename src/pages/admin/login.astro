---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Admin Login">
  <main class="max-w-md mx-auto min-h-screen flex flex-col justify-center p-6">
    <section class="bg-white rounded-3xl shadow-sm border border-slate-200 p-8">
      <div class="text-center mb-6">
        <span class="px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-bold">Supabase Auth + Admin Whitelist</span>
        <h1 class="text-2xl font-extrabold text-slate-900 mt-3">Login Admin Photobooth</h1>
        <p class="text-xs text-slate-500 mt-1">Masuk menggunakan akun email & password yang terdaftar di tabel <code>admin_users</code></p>
      </div>

      <form id="login-form" class="space-y-4">
        <div>
          <label for="email" class="block text-xs font-bold text-slate-700 mb-1">Email Admin</label>
          <input
            id="email"
            type="email"
            required
            placeholder="admin@photobooth.com"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 outline-none"
          />
        </div>
        <div>
          <label for="password" class="block text-xs font-bold text-slate-700 mb-1">Password</label>
          <input
            id="password"
            type="password"
            required
            placeholder="••••••••"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 outline-none"
          />
        </div>

        <div id="login-error" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium"></div>

        <button
          id="login-btn"
          type="submit"
          class="w-full py-3.5 px-5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm transition"
        >
          Masuk ke Dashboard
        </button>
      </form>
    </section>
  </main>

  <script>
    import { supabase } from '../../lib/supabase';

    const form = document.getElementById('login-form') as HTMLFormElement;
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const passInput = document.getElementById('password') as HTMLInputElement;
    const errorEl = document.getElementById('login-error')!;
    const loginBtn = document.getElementById('login-btn') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      if (!supabase) {
        errorEl.textContent = 'Supabase belum dikonfigurasi pada file .env.';
        errorEl.classList.remove('hidden');
        return;
      }

      loginBtn.disabled = true;
      loginBtn.textContent = 'Memverifikasi...';

      const { error } = await supabase.auth.signInWithPassword({
        email: emailInput.value.trim(),
        password: passInput.value,
      });

      if (error) {
        errorEl.textContent = error.message;
        errorEl.classList.remove('hidden');
        loginBtn.disabled = false;
        loginBtn.textContent = 'Masuk ke Dashboard';
        return;
      }

      // Verifikasi bahwa user yang login benar-benar ada di tabel admin_users (is_admin())
      const { data: isAdmin, error: roleErr } = await supabase.rpc('is_admin');
      if (roleErr || !isAdmin) {
        await supabase.auth.signOut();
        errorEl.textContent = 'Akses ditolak: Akun Anda tidak terdaftar sebagai Admin di tabel admin_users.';
        errorEl.classList.remove('hidden');
        loginBtn.disabled = false;
        loginBtn.textContent = 'Masuk ke Dashboard';
        return;
      }

      window.location.href = '/admin';
    });
  </script>
</Layout>
