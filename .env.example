# ==============================================================================
# PHOTOBOOTH QUEUE MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# Salin file ini menjadi `.env` dan isi dengan kredensial proyek Supabase Anda.
# ==============================================================================

# 1. Supabase Configuration (Wajib untuk Frontend & Backend)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# 2. Supabase Service Role Key (HANYA untuk Backend / Edge Functions)
# PERINGATAN KEAMANAN (PRD Bab 13.9): Jangan pernah mengekspos key ini di Frontend!
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 3. Web Push Notification / VAPID Keys (PRD Bab 7.2)
# Generate pasangan key menggunakan perintah: npx web-push generate-vapid-keys
PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@photobooth-domain.com"

# 4. Konfigurasi Default Aplikasi (Opsional)
PUBLIC_DEFAULT_SPEECH_LANG="id-ID"
